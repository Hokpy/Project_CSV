@{
    ViewData["Title"] = "Импорт товаров";
}

<div class="text-center">
    <h1 class="display-4">Импорт товаров интернет-магазина</h1>
    <p class="lead">Загрузите CSV-файл с товарами электроники, проверьте результат и просмотрите загруженные записи.</p>
    <div class="mt-4">
        <a asp-controller="Products" asp-action="Import" class="btn btn-primary me-2">Импортировать товары</a>
        <a asp-controller="Products" asp-action="Index" class="btn btn-outline-secondary">Открыть список товаров</a>
    </div>
</div>
